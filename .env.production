# Tu Joyita Miami - Production Environment Template
# Copiar a .env y rellenar los valores reales
# NUNCA commitear .env con credenciales reales

# ─── MySQL ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=CAMBIAR_password_root_seguro
MYSQL_DATABASE=tujoyita_db
MYSQL_USER=tujoyita_user
MYSQL_PASSWORD=CAMBIAR_password_db_seguro

# ─── WordPress ───────────────────────────────────
WORDPRESS_DB_HOST=mysql
WORDPRESS_TABLE_PREFIX=wp_

# ─── WordPress Security ─────────────────────────
# Generar en: https://api.wordpress.org/secret-key/1.1/salt/
# WORDPRESS_AUTH_KEY=
# WORDPRESS_SECURE_AUTH_KEY=
# WORDPRESS_LOGGED_IN_KEY=
# WORDPRESS_NONCE_KEY=
# WORDPRESS_AUTH_SALT=
# WORDPRESS_SECURE_AUTH_SALT=
# WORDPRESS_LOGGED_IN_SALT=
# WORDPRESS_NONCE_SALT=

# ─── WordPress Config ───────────────────────────
WORDPRESS_DEBUG=0
WORDPRESS_CONFIG_EXTRA=

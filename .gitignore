# ===== DATA: WordPress & MySQL (all runtime, ignore everything) =====
data/
data/mysql/

# ===== EXCEPT: custom WP plugin tracked in git =====
!data/wordpress/
!data/wordpress/wp-content/
!data/wordpress/wp-content/plugins/
!data/wordpress/wp-content/plugins/jewelry-dashboard/
!data/wordpress/wp-content/plugins/jewelry-dashboard/**

# Ignore everything else inside data/wordpress/
data/wordpress/*
!data/wordpress/wp-content/

data/wordpress/wp-content/*
!data/wordpress/wp-content/plugins/

data/wordpress/wp-content/plugins/*
!data/wordpress/wp-content/plugins/jewelry-dashboard/

# ===== EXCEPT: MU-plugin tracked in git =====
!data/wordpress/wp-content/mu-plugins/
data/wordpress/wp-content/mu-plugins/*
!data/wordpress/wp-content/mu-plugins/jewelry-image-optimization.php
!data/wordpress/wp-content/mu-plugins/jewelry-security.php
!data/wordpress/wp-content/mu-plugins/jewelry-dev-domain.php

# ===== DASHBOARD SPA (tracked in git) =====
# dashboard/ folder is tracked; only exclude secrets
dashboard/.env.js

# ===== ENVIRONMENT & CREDENTIALS =====
.env
.wp-credentials

# ===== LOGS =====
*.log

# ===== OS FILES =====
.DS_Store
Thumbs.db

# ===== IDE =====
.idea/
.vscode/*.backup*
*.sublime-project
*.sublime-workspace
**/*.tmp

# ===== PYTHON =====
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.coverage
htmlcov/

# ===== CACHE =====
.cache/

# ===== NODE/NPM =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ===== BACKUP / TEMP FILES =====
*.bak
*.bak*
*.swp
*.swo
*~
backups/
docker-compose.yml.backup*

# ===== WP-CONTENT ROOT (default themes/plugins, NOT data/wordpress) =====
/wp-content/

# ===== ALLOW VSCODE CONFIG =====
!.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/jewelry.code-snippets
dashboard/.env.production.js

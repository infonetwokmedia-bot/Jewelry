{
  // Line length
  "MD013": false,
  // Blanks around headings
  "MD022": false,
  // Duplicate headings (common in changelog, docs)
  "MD024": false,
  // Single title/h1
  "MD025": false,
  // No trailing punctuation in headings
  "MD026": false,
  // Ordered list item prefix (we use 1. 2. 3.)
  "MD029": false,
  // Blanks around fences
  "MD031": false,
  // Blanks around lists
  "MD032": false,
  // No bare URLs
  "MD034": false,
  // No emphasis as heading
  "MD036": false,
  // Fenced code language
  "MD040": false,
  // First line should be heading
  "MD041": false,
  // Emphasis style (asterisk vs underscore)
  "MD049": false,
  // Link fragments (Spanish accents)
  "MD051": false,
  // Blanks around tables
  "MD058": false
}
